  <diagram id="lab3-ex1-fsm" name="Lab 3 Ex1 FSM">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="LAB 3 - EXERCISE 1: TRAFFIC-LIGHT FINITE-STATE MACHINES" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="100" y="25" width="1600" height="55" as="geometry"/></mxCell>
        <mxCell id="modeTitle" value="A. SYSTEM MODE FSM" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#0B5D91;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="500" height="35" as="geometry"/></mxCell>
        <mxCell id="startMode" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#17365D;strokeColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="m1" value="MODE 1 - NORMAL&lt;br&gt;&lt;br&gt;Traffic-light FSM runs&lt;br&gt;Four 7-segment digits show countdowns" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#2672A9;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#15395B;spacing=10;" vertex="1" parent="1"><mxGeometry x="95" y="155" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="m2" value="MODE 2 - EDIT RED&lt;br&gt;&lt;br&gt;All red LEDs blink at 2 Hz&lt;br&gt;Display: 02 | red value" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDECEB;strokeColor=#C23B3B;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#653030;spacing=10;" vertex="1" parent="1"><mxGeometry x="505" y="155" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="m3" value="MODE 3 - EDIT AMBER&lt;br&gt;&lt;br&gt;All amber LEDs blink at 2 Hz&lt;br&gt;Display: 03 | amber value" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5D9;strokeColor=#C68B14;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#684D17;spacing=10;" vertex="1" parent="1"><mxGeometry x="915" y="155" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="m4" value="MODE 4 - EDIT GREEN&lt;br&gt;&lt;br&gt;All green LEDs blink at 2 Hz&lt;br&gt;Display: 04 | green value" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E8F5EA;strokeColor=#2A8A4B;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#24543B;spacing=10;" vertex="1" parent="1"><mxGeometry x="1325" y="155" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="modeNote" value="In Modes 2-4: INC increases the temporary value (1..99; 99 wraps to 1). SET saves it and remains in the current mode. All three buttons use debounced press events." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F4F6F9;strokeColor=#8192A6;fontFamily=Arial;fontSize=17;fontColor=#26394D;spacing=14;" vertex="1" parent="1"><mxGeometry x="240" y="380" width="1320" height="80" as="geometry"/></mxCell>
        <mxCell id="trafficTitle" value="B. TRAFFIC-LIGHT FSM - ACTIVE ONLY IN MODE 1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#0B5D91;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="950" height="35" as="geometry"/></mxCell>
        <mxCell id="startTraffic" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#17365D;strokeColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="t1" value="A GREEN / B RED&lt;br&gt;&lt;br&gt;Road A green; Road B red&lt;br&gt;Countdown the active phase" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E8F5EA;strokeColor=#2A8A4B;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#24543B;spacing=10;" vertex="1" parent="1"><mxGeometry x="95" y="575" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="t2" value="A AMBER / B RED&lt;br&gt;&lt;br&gt;Road A amber; Road B red&lt;br&gt;Countdown the active phase" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5D9;strokeColor=#C68B14;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#684D17;spacing=10;" vertex="1" parent="1"><mxGeometry x="505" y="575" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="t3" value="A RED / B GREEN&lt;br&gt;&lt;br&gt;Road A red; Road B green&lt;br&gt;Countdown the active phase" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E8F5EA;strokeColor=#2A8A4B;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#24543B;spacing=10;" vertex="1" parent="1"><mxGeometry x="915" y="575" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="t4" value="A RED / B AMBER&lt;br&gt;&lt;br&gt;Road A red; Road B amber&lt;br&gt;Countdown the active phase" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF5D9;strokeColor=#C68B14;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#684D17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1325" y="575" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="trafficNote" value="Safety rule: A and B are never green simultaneously. Road A represents North-South; Road B represents East-West. The red countdown covers the opposite road's green and amber phases. Validate duration combinations when SET is pressed." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F4F6F9;strokeColor=#8192A6;fontFamily=Arial;fontSize=17;fontColor=#26394D;spacing=14;" vertex="1" parent="1"><mxGeometry x="240" y="855" width="1320" height="90" as="geometry"/></mxCell>
